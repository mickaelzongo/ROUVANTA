# =====================================================================
# Rouvanta — modèle des variables d'environnement
# Copier ce fichier en ".env" puis remplacer les valeurs par les vraies.
# Le fichier .env n'est JAMAIS envoyé sur GitHub (voir .gitignore).
# =====================================================================

# --- Base de données PostgreSQL ---
DB_NAME=rouvanta
DB_USER=rouvanta
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# --- pgAdmin (interface web pour la base, optionnel) ---
PGADMIN_EMAIL=admin@rouvanta.local
PGADMIN_PASSWORD=change-me

# --- Sécurité JWT ---
# Clé secrète d'au moins 32 caractères (256 bits), longue et aléatoire.
JWT_SECRET=change-me-with-a-long-random-secret-of-at-least-32-chars
# Durée de validité du jeton en millisecondes (86400000 = 24 h)
JWT_EXPIRATION_MS=86400000

# --- E-mails (Mailpit en développement) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@rouvanta.local

# --- Assistant IA ---
# Fournisseur : ollama (local, gratuit) | mistral | openai
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434
AI_MODEL=qwen2.5:7b
# Clé API : seulement pour mistral / openai (laisser vide pour ollama)
AI_API_KEY=
